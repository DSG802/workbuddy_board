# ---------- Python 虚拟环境 ----------
.venv/
.venv-x64/
venv/
env/

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---------- 打包产物 ----------
build/
build-*/
dist/
dist-*/
*.app/
*.onefile
# 单文件打包前写入构建标记的 app/ 暂存副本
.stage/
# 构建脚本在仓库根下生成的校验文件
/SHA256SUMS.txt

# ---------- 安卓构建产物 ----------
android/app/build/
android/.gradle/
android/build/
android/local.properties
android/.idea/
# build.sh 从 app/ 与 pysrc/ 同步生成的副本，不入库
android/app/src/main/python/

# ---------- 签名密钥（绝不入库）----------
android/keystore/
keystore.properties
*.jks
*.keystore
*.p12
*.pem
*.key

# ---------- 安装包 / 大二进制 ----------
*.apk
*.aab
*.zip
*.dmg
*.exe
*.msi
*.tar.gz

# ---------- 下载站静态资源（体积大，走服务器）----------
site/html/
site/files/
site/src/

# ---------- 运行时数据 ----------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log

# ---------- 系统 / 编辑器 ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---------- 服务器版运行时状态（含 JWT / 扫码会话，绝不入库）----------
server/state/
server/.env
.env

# ---------- PyInstaller spec（每次构建按当前架构重写，不入库）----------
*.spec

# ---------- 盯群脚本的运行态（游标 / 本地待办队列 / 本地密钥）----------
tools/.im-last-win
tools/pending-win.jsonl
tools/config.json
tools/autoreply-win.log
