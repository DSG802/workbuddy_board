# 复制成 .env 再改；.env 不入库。只有 PUSH_SECRET 必须改（不改即不启用推送）。

TZ=Asia/Shanghai

# 多用户：访客各自登录自己的账户（0 = 只有站长单账户）
MULTIUSER=1

# 只读镜像实例：1 = 只展示，不签到、不派猫、不续期令牌
ARCHIVE_MODE=0

# 自动签到：窗口内随机尝试
CHECKIN_WINDOW=9-12
CHECKIN_TRIES=4

# 派猫：当天首次落在 TRAVEL_WINDOW 内，之后在 TRAVEL_DAY_WINDOW 内多趟
TRAVEL_WINDOW=9-12
TRAVEL_DAY_WINDOW=9-22

# 轮询间隔（分钟）
BALANCE_MINUTES=30
TRAVEL_MINUTES=10
TRAVEL_ENABLE=1

# 可选：签名密钥 + 回调地址，留空则不推送
PUSH_SECRET=
WEBHOOK_URL=
